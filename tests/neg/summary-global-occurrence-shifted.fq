// tests/elim/summary-global-occurrence.fq with a goal that the occurrence's
// declaration of g does not give: w = g + 1 must stay UNSAFE.
constant g : (int)

bind 0 g : {v : int | true}
bind 1 z : {v : int | true}
bind 2 w : {v : int | true}
bind 3 p : {v : int | $k0[z := w][v := p]}

constraint:
  env [ ]
  lhs {v : int | true}
  rhs {v : int | $k0[z := g]}
  id 1 tag []

constraint:
  env [0; 2; 3]
  lhs {v : int | v = p}
  rhs {v : int | w = g + 1}
  id 2 tag []

wf:
  env [1]
  reft {v : int | $k0}
