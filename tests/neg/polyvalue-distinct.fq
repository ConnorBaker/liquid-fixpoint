// Different family names must not be conflated at a common result sort.
data Token 0 = [ | First {} | Second {} ]
constant family : func(1, [Set_Set @(0)])
constant other : func(1, [Set_Set @(0)])

constraint:
  env []
  lhs {v : Set_Set Token | v = family}
  rhs {v : Set_Set Token | v = other}
  id 0 tag []
