fixpoint "--rewrite"
fixpoint "--local-rewrites"
data Token 0 = [ | First {} | Second {} ]
constant empty : func(1, [Set_Set @(0)])
bind 0 localValue : {v : Set_Set Token | []}
defineLocal 0 [localValue := empty]
bind 1 witness : {v : Set_Set Token | v = empty}
constraint:
  env [0; 1]
  lhs {v : Set_Set Token | v = localValue}
  rhs {v : Set_Set Token | v = witness}
  id 0 tag []
expand [0 : True]
