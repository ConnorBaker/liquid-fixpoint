
// A phantom parameter must not introduce any additional constructors.
// Observe both parameter instances rather than just declaring their sorts.

data Boo 1 = [
  | bling { booFirst : int  }
]

data LL 1 = [
  | emp { }
  | con { lHead : @(0), lTail : LL @(0)}
]

bind 1 x  : {v: Boo int  | true}
bind 2 y  : {v: Boo bool | true}
bind 3 z  : {v: int      | z = 12}

constraint:
  env [1;2;3]
  lhs {v : int | v = z + 1 }
  rhs {v : int | v < 20    }
  id 1 tag []

constraint:
  env [1;2]
  lhs {v : int | true }
  rhs {v : int | is$bling x && is$bling y }
  id 2 tag []

constraint:
  env [1;2]
  lhs {v : int | true }
  rhs {v : int | x = bling (booFirst x) && y = bling (booFirst y) }
  id 3 tag []
