// g is bound in every constraint that mentions $k0, so it is a common binder
// of $k0 and stays a parameter of $k0's summary. The occurrences know
// incompatible facts about g: g > 0 at the top-level occurrence, g < 0 inside
// $k1's defining cube. The shared summary must carry neither.

bind 0 g : {v : int | true}
bind 1 x : {v : int | v = g}
bind 2 h1 : {v : int | g > 0}
bind 3 p : {v : int | $k0[v:=p]}
bind 4 h2 : {v : int | g < 0}
bind 5 q : {v : int | $k0[v:=q]}
bind 6 r : {v : int | $k1[v:=r]}

constraint:
  env [0; 1]
  lhs {v : int | v = x}
  rhs {v : int | $k0}
  id 1 tag []

constraint:
  env [0; 2; 3]
  lhs {v : int | v = p}
  rhs {v : int | v > 0}
  id 2 tag []

constraint:
  env [0; 4; 5]
  lhs {v : int | v = q}
  rhs {v : int | $k1}
  id 3 tag []

constraint:
  env [0; 6]
  lhs {v : int | v = r}
  rhs {v : int | v < 0}
  id 4 tag []

wf:
  env [ ]
  reft {v : int | $k0}

wf:
  env [ ]
  reft {v : int | $k1}
