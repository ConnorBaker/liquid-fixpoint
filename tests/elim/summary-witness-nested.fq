// The goal needs a fact (x > 0) reached only through $k2, which is itself
// reached only through the cube of $k1: a summary nested in a summary.

bind 0 x : {v : int | v > 0}
bind 1 z : {v : int | $k2[v:=z]}
bind 2 y : {v : int | $k1[v:=y]}

constraint:
  env [0]
  lhs {v : int | v = x}
  rhs {v : int | $k2}
  id 1 tag []

constraint:
  env [1]
  lhs {v : int | v = z}
  rhs {v : int | $k1}
  id 2 tag []

constraint:
  env [2]
  lhs {v : int | v = y}
  rhs {v : int | v > 0}
  id 3 tag []

wf:
  env [ ]
  reft {v : int | $k1}

wf:
  env [ ]
  reft {v : int | $k2}
